DATABASE_URL=postgres://postgres:postgres@localhost:5432/hops
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hops_test
PORT=3000

# Notifications wait this long before sending, so quick edits/deletes are respected (§2.6)
GRACE_MS=10000
# Notifications for messages older than this are dropped as stale (§2.6)
STALE_MS=900000

# Fake external systems: latency range (min-max ms) and failure probability (0-1)
SEARCH_LATENCY_MS=100-800
SEARCH_FAILURE_RATE=0
NOTIFY_LATENCY_MS=100-500
NOTIFY_FAILURE_RATE=0
